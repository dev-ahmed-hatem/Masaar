# ==============================================================================
# Masaar — monorepo .gitignore
# Stack: Flutter (student app) · Django/DRF (API) · Next.js (teacher + admin web)
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & environment  (NEVER commit real secrets — keep *.example templates)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.keystore
*.jks
secrets/
credentials.json
service-account*.json
google-services.json
GoogleService-Info.plist

