# Copy to api/.env and adjust. Never commit the real .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — SQLite is used by default in dev when DATABASE_URL is unset.
# For PostgreSQL:
# DATABASE_URL=postgres://masaar:masaar@localhost:5432/masaar

# CORS (web app origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google Calendar integration (optional) ---
# Create a Google Cloud project, enable the Google Calendar API, configure the
# OAuth consent screen, and create an "OAuth 2.0 Client ID" of type "Web
# application". Register GOOGLE_OAUTH_REDIRECT_URI (below) on that client, and
# add your test accounts as test users on the consent screen. Leaving the client
# id/secret blank disables the whole integration (bookings still work with
# manually pasted meeting links).
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx
# Must exactly match a redirect URI registered on the OAuth client (the web app).
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/en/settings/google/callback
# Fernet key for encrypting stored OAuth tokens at rest. Keep it stable — changing
# it invalidates all stored tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
